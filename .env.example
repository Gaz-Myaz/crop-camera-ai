# Copy to .env (which is gitignored) and fill in your own values,
# or export these directly in your shell.
#
#   macOS / Linux:  export DEEPSEEK_API_BASE="http://your-server:8888/v1"
#   Windows:        setx DEEPSEEK_API_BASE "http://your-server:8888/v1"

# OpenAI-compatible endpoint of your LLM server (vLLM, SGLang, Ollama, ...).
# Note the trailing /v1 -- some clients append it themselves, which yields
# a /v1/v1 404 if you include it twice.
DEEPSEEK_API_BASE=http://your-llm-server:8888/v1

# Model name AS REGISTERED ON YOUR SERVER, not the HuggingFace path.
# Using the HF path when the server registered a short alias is a common
# cause of 404s.
DEEPSEEK_MODEL=your-model-name

# No API key is needed for a local vLLM server -- it accepts any non-empty
# string, and that's what these scripts send.
